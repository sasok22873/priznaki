{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": [
      "react",
      "react-native",
      "node"
    ],
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@pb/shared": [
        "../../packages/shared/src/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "App.tsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}